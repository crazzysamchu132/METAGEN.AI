{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "A user profile storing metadata generator access roles, security status, and credits balance.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "user"] },
        "isBanned": { "type": "boolean" },
        "banReason": { "type": "string" },
        "points": { "type": "integer", "description": "The user's credits balance for metadata generation." },
        "lastDailyReset": { "type": "string", "description": "Local date YYYY-MM-DD of the user's last daily 50 pts top-up." },
        "lastLogin": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "domain": { "type": "string" }
      },
      "required": ["uid", "email", "role", "points", "lastDailyReset"]
    },
    "ImageMetadata": {
      "title": "Image Metadata",
      "description": "Structured metadata generated for an image by AI.",
      "type": "object",
      "properties": {
        "file_name": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "keywords": {
          "type": "array",
          "items": { "type": "string" }
        },
        "category": { "type": "string" },
        "dominant_colors": {
          "type": "array",
          "items": { "type": "string" }
        },
        "objects_detected": {
          "type": "array",
          "items": { "type": "string" }
        },
        "mood": { "type": "string" },
        "usage_suggestions": { "type": "string" }
      },
      "required": [
        "file_name", "title", "description", "keywords", "category",
        "dominant_colors", "objects_detected", "mood", "usage_suggestions"
      ]
    },
    "ScanRecord": {
      "title": "Scan Record",
      "description": "A record of an image scan including the metadata and owner info.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "metadata": { "$ref": "ImageMetadata" },
        "imageUrl": { "type": "string", "description": "Preview URL if available." },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "metadata", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Users of METAGEN.AI with roles, bans, and credits balance metadata."
    },
    "/scans/{scanId}": {
      "schema": "ScanRecord",
      "description": "History of generated image metadata records."
    }
  }
}
